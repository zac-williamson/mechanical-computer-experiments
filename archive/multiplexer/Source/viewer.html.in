<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>16T-compatible axle spacing</title><style>body{margin:0;background:#f6f5ee;color:#263e40;font:15px/1.5 system-ui}main{max-width:1300px;margin:auto;padding:22px}h1{margin:4px 0;font-size:28px}.note{padding:12px;background:#eee3c7}.tools{display:flex;flex-wrap:wrap;gap:14px;margin:12px 0;align-items:center}button,select{padding:7px;border:1px solid #87998d;background:#fff;border-radius:5px;color:inherit}canvas{width:100%;height:62vh;min-height:380px;touch-action:none}#status{min-height:24px}a{color:#176a75}</style><main><p>MECHANICAL COMPUTER / MULTIPLEXER</p><h1>16T-compatible axle spacing</h1><p>Axle centre distance: 16.000 mm. Worm and actuator moved -5.65 mm in Y and +1.50 mm in Z; fork connection extended by the same amount.</p><p class="note">Current multiplexer: aligned 16T axle spacing, two-piece carriage and +X cheek mounts. CAD checks do not establish physical friction or load endurance.</p><div class="tools"><button id="run">Play switching</button><button id="xz">XZ view</button><button id="iso">Perspective view</button><button id="zy">Side view</button><button id="fit">Fit</button><label><input id="frame" type="checkbox" checked>Support structure</label><label>Inspect <select id="part"><option value="">Complete assembly</option><option value="carriage">Two-piece carriage only</option><option value="actuator">Actuator only</option></select></label></div><div class="tools"><label>A <select id="a"><option value="-1">0 · clockwise</option><option value="1">1 · anticlockwise</option></select></label><label>B <select id="b"><option value="1">1 · anticlockwise</option><option value="-1">0 · clockwise</option></select></label><span>Directions viewed toward the origin from +X. Positive selector rotation selects A.</span></div><input id="timeline" type="range" min="0" max="3659" value="0" style="width:100%"><div id="status"></div><div style="position:relative"><canvas id="view"></canvas><svg id="axes" viewBox="0 0 190 190" width="190" height="190" aria-label="Model coordinate axes" style="position:absolute;right:8px;top:8px;pointer-events:none;background:#ffffffdd;border-radius:8px"></svg></div><p>Drag to rotate · Shift-drag to pan · Scroll to zoom. The animation follows the computed rigid-contact switching path; it does not simulate force, clutch tooth alignment, or friction.</p><p><a href="README.md">Design, checks and assembly</a> · <a href="orthographic.png">Assembly views</a></p><div id="error"></div></main><script type="application/json" id="data">__MODEL_DATA__</script><script>
(async()=>{try{
const $=s=>document.querySelector(s),D=JSON.parse($('#data').textContent),cv=$('#view'),gl=cv.getContext('webgl',{antialias:true,alpha:false});if(!gl)throw Error('WebGL unavailable');
const bytes=Uint8Array.from(atob(D.geometry),x=>x.charCodeAt(0)),all=new Float32Array(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer());
function sh(t,s){let a=gl.createShader(t);gl.shaderSource(a,s);gl.compileShader(a);if(!gl.getShaderParameter(a,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(a));return a}
const pg=gl.createProgram();gl.attachShader(pg,sh(gl.VERTEX_SHADER,`attribute vec3 p;attribute vec3 n;uniform mat3 cam;uniform mat3 model;uniform vec3 shift;uniform vec3 center;uniform vec3 col;uniform vec2 scale;uniform vec2 pan;varying vec3 c;void main(){vec3 v=cam*(model*p+shift-center);gl_Position=vec4(v.x*scale.x+pan.x,v.y*scale.y+pan.y,-v.z/1500.,1.);vec3 normal=normalize(cam*model*n);c=col*(.43+.57*abs(dot(normal,normalize(vec3(-.4,.7,1.)))));}`));gl.attachShader(pg,sh(gl.FRAGMENT_SHADER,`precision mediump float;varying vec3 c;void main(){gl_FragColor=vec4(c,1.);}`));gl.linkProgram(pg);gl.useProgram(pg);const L={};for(let k of ['p','n'])L[k]=gl.getAttribLocation(pg,k);for(let k of ['cam','model','shift','center','col','scale','pan'])L[k]=gl.getUniformLocation(pg,k);
function buf(v){let b=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,v,gl.STATIC_DRAW);return b}
function normals(v){let n=new Float32Array(v.length);for(let i=0;i<v.length;i+=9){let a=[v[i+3]-v[i],v[i+4]-v[i+1],v[i+5]-v[i+2]],b=[v[i+6]-v[i],v[i+7]-v[i+1],v[i+8]-v[i+2]],r=[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]],l=Math.hypot(...r)||1;for(let j=0;j<9;j++)n[i+j]=r[j%3]/l}return n}
const parts=D.parts.map(p=>{let v=all.subarray(p.offset,p.offset+p.vertices*3);return {...p,vb:buf(v),nb:buf(normals(v))}});for(const p of parts){let o=document.createElement('option');o.value=p.id;o.textContent=p.id;$('#part').append(o)}
const ID=[1,0,0,0,1,0,0,0,1],mul=(R,v)=>[0,1,2].map(k=>R[k]*v[0]+R[k+3]*v[1]+R[k+6]*v[2]);
function rot(axis,a,o){let c=Math.cos(a),s=Math.sin(a),R=axis==='X'?[1,0,0,0,c,s,0,-s,c]:[c,0,-s,0,1,0,s,0,c],r=mul(R,o);return[R,o.map((v,k)=>v-r[k])]}
function band(beta){let[R,t]=rot('Y',beta,D.pivot),bb=mul(R,D.bandB).map((v,k)=>v+t[k]),a=D.bandA,b=bb,ang=Math.atan2(b[2]-a[2],b[0]-a[0]),outer=[],inner=[];for(let end=0;end<2;end++)for(let j=0;j<=32;j++){let theta=ang+(end===0?Math.PI/2:-Math.PI/2)+j*Math.PI/32,p=end===0?a:b;outer.push([p[0]+3.2*Math.cos(theta),p[2]+3.2*Math.sin(theta)]);inner.push([p[0]+2*Math.cos(theta),p[2]+2*Math.sin(theta)])}let v=[];function pt(p,y){return[p[0],y,p[1]]}function quad(a,b,c,d){v.push(...a,...b,...c,...a,...c,...d)}for(let i=0;i<outer.length;i++){let j=(i+1)%outer.length;for(let y of [9.60,10.80])quad(pt(outer[i],y),pt(outer[j],y),pt(inner[j],y),pt(inner[i],y));for(let ar of [outer,inner])quad(pt(ar[i],9.60),pt(ar[j],9.60),pt(ar[j],10.80),pt(ar[i],10.80))}return new Float32Array(v)}
let az=-1.1,el=.7,zoom=1,px=0,py=0,idx=0,playing=false,last=0,drag=null,scheduled=false;
function draw(now){scheduled=false;if(playing){idx=Math.min(D.trace.length-1,idx+(last?Math.min((now-last)/1000,.1)*100:0));last=now;if(idx===D.trace.length-1){playing=false;$('#run').textContent='Replay'}}else last=0;let f=D.trace[Math.floor(idx)],beta=f.b*Math.PI/180,w=cv.clientWidth,h=cv.clientHeight,dpr=Math.min(devicePixelRatio||1,2);cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr);gl.viewport(0,0,cv.width,cv.height);gl.clearColor(.965,.969,.937,1);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);gl.enable(gl.DEPTH_TEST);let ca=Math.cos(az),sa=Math.sin(az),ce=Math.cos(el),se=Math.sin(el),right=[-sa,0,ca],up=[-ca*se,-ce,-sa*se],toward=[ca*ce,-se,sa*ce];gl.uniformMatrix3fv(L.cam,false,[right[0],up[0],toward[0],right[1],up[1],toward[1],right[2],up[2],toward[2]]);gl.uniform3f(L.center,0,15,8);let dx=0,dy=0;for(let k=0;k<8;k++){let v=[D.bounds[k&1?1:0][0],D.bounds[k&2?1:0][1]-15,D.bounds[k&4?1:0][2]-8];dx=Math.max(dx,Math.abs(v.reduce((a,b,i)=>a+b*right[i],0)));dy=Math.max(dy,Math.abs(v.reduce((a,b,i)=>a+b*up[i],0)))}let fit=zoom*.9/Math.max(dx,dy*w/h);gl.uniform2f(L.scale,fit,fit*w/h);gl.uniform2f(L.pan,px,py);
let axisSvg='<text x="10" y="17" fill="#263e40" font-size="12">Model axes</text>';
for(let k of [0,1,2].sort((a,b)=>toward[a]-toward[b])){let color=['#cf3636','#23834a','#2767cf'][k],name='XYZ'[k],cx=95,cy=99,x=cx+62*right[k],y=cy-62*up[k],nx=cx-38*right[k],ny=cy+38*up[k];axisSvg+=`<line x1="${nx}" y1="${ny}" x2="${cx}" y2="${cy}" stroke="${color}" stroke-width="1.5" stroke-dasharray="4 3"/><line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="${color}" stroke-width="3"/><circle cx="${x}" cy="${y}" r="4" fill="${color}"/><text x="${x+6}" y="${y-6}" fill="${color}" font-size="15" font-weight="700">+${name}</text>`;if(Math.hypot(right[k],up[k])<.12)axisSvg+=`<text x="12" y="177" fill="${color}" font-size="12">+${name} ${toward[k]>0?'toward you':'away from you'}</text>`;else axisSvg+=`<text x="${nx-8}" y="${ny+14}" fill="${color}" font-size="11">−${name}</text>`;}
$('#axes').innerHTML=axisSvg;
let chosen=$('#part').value;for(let p of parts){if(chosen==='carriage'&&p.motion!=='carriage')continue;if(chosen==='actuator'&&!['Merged bearing and arm','Short lever','U022','U015','Elastic band','Front bearing cheek','Rear bearing cheek','Single braced carriage','Left carriage bearing support','Right carriage bearing support','Carriage fork and roof','reaction-stop-axle','pivot-stop-axle','reaction-retainer','pivot-retainer'].includes(p.id))continue;if(chosen&&chosen!=='actuator'&&chosen!=='carriage'&&p.id!==chosen)continue;if(p.kind==='structure'&&!$('#frame').checked)continue;let R=ID,t=[0,0,0],mo=p.motion;
if(mo==='carriage')t=[f.q,0,0];if(mo==='rocker')[R,t]=rot('Y',beta,D.pivot);if(mo==='gear')[R,t]=rot('Y',f.g*Math.PI/180,D.reaction);if(mo==='worm'||mo==='input'){[R,t]=rot('X',f.w*Math.PI/180,[0,10.2,16.0]);if(mo==='worm')t[0]+=f.q}
if(['A','B','A-idler','B-idler','O','O-route','clutch-ring'].includes(mo)){let sign=+(mo.startsWith('A')?$('#a').value:mo.startsWith('B')?$('#b').value:f.q>=0?$('#a').value:$('#b').value);[R,t]=rot('X',idx*.025*sign*(mo.includes('idler')?-2:1),[0,p.axisY,p.axisZ]);if(mo==='clutch-ring')t[0]=Math.sign(f.q)*Math.max(Math.abs(f.q)-.4,0)}
if(mo==='band'){let v=band(beta);for(let [b,a]of[[p.vb,v],[p.nb,normals(v)]]){gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,a,gl.DYNAMIC_DRAW)}p.vertices=v.length/3}
gl.uniformMatrix3fv(L.model,false,R);gl.uniform3f(L.shift,...t);gl.uniform3f(L.col,...p.color.map(x=>x/255));for(let[k,b]of[['p',p.vb],['n',p.nb]]){gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.enableVertexAttribArray(L[k]);gl.vertexAttribPointer(L[k],3,gl.FLOAT,false,0,0)}gl.drawArrays(gl.TRIANGLES,0,p.vertices)}$('#timeline').value=idx;$('#status').textContent=f.segment+' · Travel '+f.q.toFixed(3)+' mm · Lever '+f.b.toFixed(1)+'° · '+(Math.abs(f.q)<3.3?'Clutch transferring':f.q>0?'A selected':'B selected');if(playing)schedule()}
function schedule(){if(!scheduled){scheduled=true;requestAnimationFrame(draw)}}$('#run').onclick=()=>{if(idx>=D.trace.length-1)idx=0;playing=!playing;$('#run').textContent=playing?'Pause':'Play switching';schedule()};$('#timeline').max=D.trace.length-1;$('#timeline').oninput=()=>{idx=+$('#timeline').value;playing=false;$('#run').textContent='Play switching';schedule()};for(let id of ['frame','part','a','b'])$('#'+id).onchange=schedule;$('#xz').onclick=()=>{az=-Math.PI/2;el=Math.PI/2;schedule()};$('#iso').onclick=()=>{az=-1.1;el=.7;schedule()};$('#zy').onclick=()=>{az=0;el=0;schedule()};$('#fit').onclick=()=>{zoom=1;px=py=0;schedule()};cv.oncontextmenu=e=>e.preventDefault();cv.onpointerdown=e=>{cv.setPointerCapture(e.pointerId);drag=[e.clientX,e.clientY,e.shiftKey||e.button===2]};cv.onpointermove=e=>{if(!drag)return;if(drag[2]){px+=2*(e.clientX-drag[0])/w();py-=2*(e.clientY-drag[1])/cv.clientHeight}else{az+=(e.clientX-drag[0])*.008;el=Math.max(-1.57,Math.min(1.57,el+(e.clientY-drag[1])*.008))}drag=[e.clientX,e.clientY,drag[2]];schedule()};function w(){return cv.clientWidth}cv.onpointerup=cv.onpointercancel=()=>drag=null;cv.addEventListener('wheel',e=>{e.preventDefault();zoom=Math.max(.4,Math.min(12,zoom*Math.exp(-e.deltaY*.001)));schedule()},{passive:false});new ResizeObserver(schedule).observe(cv);schedule();window.viewerReady=true;
}catch(e){document.querySelector('#error').textContent=e.stack||e.message}})();
</script></html>